    subgraph "Firebase Backend Services collabcanvas-mvp-53120"
        subgraph "Firebase Authentication"
            FBAuth[Firebase Authentication<br/>Email/Password ONLY<br/>JWT Token Management<br/>User Profile Storage<br/>⚠️ Google OAuth: Planned but NOT Implemented]
        end

        subgraph "Cloud Firestore Database"
            CanvasCollection[Canvas Collection<br/>Document: global-canvas-v1<br/>Multi-Shape Array with Metadata<br/>Phase 2: Line/Arrow types<br/>Phase 3: AI metadata createdBy, aiCommand<br/>Phase 4: zIndex, visible, locked]
            ShapeSchema[Multi-Shape Schema Phase 1-4:<br/>id, type rectangle/circle/text/line/arrow<br/>x, y, width, height, radius<br/>fill: DYNAMIC 20+ color palette Phase 2<br/>text content + formatting Phase 2<br/>points array for line/arrow Phase 2<br/>createdBy, lastModifiedBy, aiCommand Phase 3<br/>isLocked, lockedBy, timestamps<br/>zIndex, visible, locked Phase 4]
            SecurityRules[firestore.rules<br/>Authenticated User Access<br/>Shape Ownership Validation<br/>Production Deployed<br/>Phase 4: Rate Limiting]
        end

        subgraph "Firebase Realtime Database"
            SessionsPath[Sessions Path<br/>/sessions/global-canvas-v1/userId<br/>High-Frequency Updates<br/>Phase 4: 50ms throttle optimization]
            CursorData[Enhanced Cursor Data:<br/>displayName editable<br/>cursorColor customizable 8 colors<br/>cursorX, cursorY throttled 100ms→50ms Phase 4<br/>isOnline boolean<br/>lastSeen timestamp]
            PresenceSystem[Enhanced Presence System<br/>Online/Offline Detection<br/>30-second Grace Period<br/>5-second Heartbeat<br/>onDisconnect Cleanup<br/>Connection Monitoring]
        end

        subgraph "Firebase Hosting Production"
            StaticHosting[Static File Hosting<br/>React App Deployment<br/>CDN Distribution<br/>SPA Routing Configured<br/>Cache Headers Optimized<br/>Live: collabcanvas-mvp-53120.web.app<br/>Phase 5: Final Production Deploy]
        end

        subgraph "Firebase Configuration"
            FirebaseRules[firebase/ Directory<br/>firestore.rules deployed<br/>database.rules.json deployed<br/>firebase.json SPA config<br/>Phase 4: Performance rules]
        end
    end

    subgraph "External AI Services Phase 3 NEW"
        OpenAI[OpenAI API<br/>Model: gpt-4o-mini<br/>Tool Calling Feature<br/>Response <2s target<br/>Cost: ~$0.01/command<br/>Budget: $15-20 Phase 3]
        LangSmith[LangSmith Platform Phase 5 NEW<br/>smith.langchain.com<br/>Automatic Tracing<br/>Performance Metrics<br/>Cost Analysis Dashboard<br/>Free Tier: $0<br/>+2 BONUS POINTS]
    end

    subgraph "Real-time Data Flow"
        subgraph "Multi-Shape Synchronization Phase 1+2"
            ShapeCreate[Multi-Shape Creation<br/>Rectangle/Circle/Text/Line/Arrow<br/>→ Firestore Real-time Listener<br/>Phase 2: 5 shape types]
            ShapeUpdate[Shape Updates<br/>Drag/Edit/Color/Transform<br/>→ Position/Text/Color/Size Update<br/>Sync <500ms Phase 1<br/>Sync <100ms Phase 4]
            ShapeLocking[Object Locking<br/>First User Locks<br/>→ Others See Lock State<br/>30-second Timeout]
            ColorSync[Color Synchronization<br/>20+ color Palette Phase 2<br/>Real-time Updates]
            TextSync[Text Editing Sync<br/>Double-click to Edit<br/>Phase 2: Formatting sync<br/>Real-time Text Updates]
            UndoRedoSync[Undo/Redo Phase 2 NEW<br/>Per-user Action History<br/>Local Undo/Redo<br/>Firestore State Sync<br/>Multi-user Isolation]
        end

        subgraph "AI Command Flow Phase 3 NEW"
            AICommandInput[User Natural Language Input<br/>Create a red circle<br/>Arrange shapes horizontally<br/>Build a login form]
            AIToolCalling[OpenAI Tool Calling<br/>CANVAS_TOOLS schemas<br/>Extract tool_calls from response<br/>12+ tool functions]
            AIExecution[executeToolCall Function<br/>Switch-based routing<br/>create_shape, move_shape, etc.<br/>Returns CommandResult]
            AIFirestoreSync[AI → Firestore Sync<br/>addShape via useShapes<br/>updateShape operations<br/>Metadata: createdBy='ai'<br/>Multi-user sync automatic]
            AIPerformance[AI Performance Tracking<br/>Response time <2s<br/>90%+ accuracy target<br/>Command caching 15min<br/>Phase 5: LangSmith metrics]
        end

        subgraph "Enhanced User Presence Flow Phase 1+4"
            CursorTracking[Cursor Tracking<br/>Mouse Move → RTDB Update<br/>Phase 1: <200ms throttled 100ms<br/>Phase 4: <50ms optimization]
            UserJoinLeave[User Join/Leave<br/>Auth State → Presence Update<br/>30-second Grace Period]
            ConnectionMonitoring[Connection Monitoring<br/>Firebase Status Detection<br/>Toast Notifications<br/>onDisconnect → Cleanup]
            HeartbeatSystem[Heartbeat System<br/>5-second Intervals<br/>Keep Users Online]
        end

        subgraph "Performance Optimization Phase 4"
            ViewportCulling[Viewport Culling<br/>Render only visible shapes<br/>+ 500px buffer<br/>500+ shapes at 60 FPS]
            ShapePooling[Shape Pooling/Recycling<br/>Reuse Konva instances<br/>Reduce GC overhead<br/>Memory optimization]
            BatchOperations[Firestore Batching<br/>100ms batch window<br/>writeBatch for bulk ops<br/>Reduce write operations]
        end
    end

    subgraph "Multi-User Collaboration Architecture"
        User1[User 1 Browser<br/>Designer/Canvas Owner<br/>Multi-Shape Creation & Management<br/>Phase 3: AI Commands]
        User2[User 2 Browser<br/>Collaborator<br/>Join via Shared URL<br/>Phase 3: Sees AI shapes]
        User3[User 3 Browser<br/>Additional Collaborator<br/>Real-time Participation<br/>Phase 3: Can use AI]

        ShareableURL[Production URL<br/>collabcanvas-mvp-53120.web.app<br/>Direct Canvas Access<br/>Firebase Hosted<br/>Phase 5: Final Production]
    end

    subgraph "Production Build Architecture Phase 1+5"
        CodeSplitting[Code Splitting Strategy<br/>react-vendor: React + React-DOM<br/>firebase-vendor: Firebase SDK<br/>konva-vendor: Konva + React-Konva<br/>Phase 5: openai-vendor + langsmith-vendor]
        Minification[esbuild Minification<br/>Fast Build Performance<br/>Source Maps Disabled<br/>Console Logs Preserved]
        BundleAnalysis[Bundle Analysis<br/>Phase 1: ~335 KB gzipped<br/>Phase 5 Est: ~450 KB gzipped<br/>Chunk Size Warnings @ 1000KB<br/>Production Optimized]
    end

