    class User1,User2,User3,ShareURL userLayer
    class React,Vite,TypeScript,Tailwind frontendCore
    class Konva,ReactKonva canvasEngine
    class Canvas,Toolbar,Rectangle,Circle,Text,UserPresence,Cursor,useAuth,useCanvas,useShapes,usePresence,useToast componentPhase1
    class Line,Arrow,ColorPaletteModal,ExportModal,KeyboardShortcutsPanel,ShapeStylePanel,useUndoRedo,useKeyboardShortcuts,ExportService componentPhase2a
    class TransformerEnhanced,SmartGuides,MarqueeSelection componentPhase2bFigma
    class AICommandPanel,useAIAgent,useCommandHistory,OpenAIService,AIAgentService,AICommands,AITypes componentPhase3AI
    class PerformanceMonitor,ViewportCullingComp,ShapePoolingComp,PerformanceService componentPhase4aPerformance
    class LayersPanel,PropertiesPanel,AlignmentTools componentPhase4bFigma
    class FirebaseConfig,FirestoreService,RealtimeService,AuthService servicesLayer
