    classDef componentPhase4 fill:#e0f2f1,stroke:#00695c,stroke-width:2px
    classDef hooksLayer fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    classDef servicesLayer fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef firebaseService fill:#ffccbc,stroke:#d84315,stroke-width:2px
    classDef aiService fill:#ff99cc,stroke:#cc0066,stroke-width:3px
    classDef buildTools fill:#cfd8dc,stroke:#455a64,stroke-width:2px
    classDef libraries fill:#d1c4e9,stroke:#512da8,stroke-width:2px

