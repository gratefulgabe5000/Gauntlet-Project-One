    class Line,Arrow,ColorPaletteModal,ExportModal,KeyboardShortcutsPanel,useUndoRedo,useKeyboardShortcuts,ExportService componentPhase2
    class AICommandPanel,useAIAgent,useCommandHistory,OpenAIService,AIAgentService,AICommands,AITypes componentPhase3AI
    class LayersPanel,AlignmentTools,AlignmentService,PerformanceService componentPhase4
    class FirebaseConfig,FirestoreService,RealtimeService,AuthService servicesLayer
