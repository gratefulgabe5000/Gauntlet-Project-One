    classDef componentPhase3AI fill:#ffebee,stroke:#c62828,stroke-width:3px
    classDef componentPhase4aPerformance fill:#cc99ff,stroke:#6600cc,stroke-width:2px
    classDef componentPhase4bFigma fill:#aa99ff,stroke:#3300cc,stroke-width:3px
    classDef hooksLayer fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    classDef servicesLayer fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
