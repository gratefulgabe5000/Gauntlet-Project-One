# CollabCanvas Environment Variables
# Copy this file to .env.local and fill in your actual values

# OpenAI API Key (Required for Phase 3: AI Canvas Agent)
# Get your key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-proj-your-openai-key-here

# LangSmith API Key (Optional - Phase 4a: AI Observability +2 bonus points)
# Get your key from: https://smith.langchain.com/settings
# Free tier: 50,000 traces/month
VITE_LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-key-here

# LangSmith Configuration (Optional)
VITE_LANGCHAIN_TRACING_V2=true
VITE_LANGCHAIN_PROJECT=collabcanvas-ai-agent

# Firebase Configuration (Already configured in firebase.ts)
# These are public and can be committed to the repo

