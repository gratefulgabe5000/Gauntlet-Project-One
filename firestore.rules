rules_version = '2';

/**
 * Firestore Security Rules for CollabCanvas MVP
 *
 * PR4.7: Firestore Security Rules
 *
 * Security Requirements:
 * - Only authenticated users can read/write
 * - All users share access to the global canvas
 * - Users can create new shapes
 * - Users can update/delete any shape (collaborative canvas)
 * - Rate limiting handled by Firebase default limits
 *
 * Database Structure:
 * /canvases/{canvasId}
 *   - canvasId: string
 *   - shapes: array of Shape objects
 *   - metadata: object with canvas info
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns a resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Canvas documents - collaborative access for authenticated users
    match /canvases/{canvasId} {

      // Allow authenticated users to read any canvas
      allow read: if isAuthenticated();

      // Allow authenticated users to create new canvas documents
      allow create: if isAuthenticated()
                    && request.resource.data.canvasId is string
                    && request.resource.data.shapes is list
                    && request.resource.data.metadata is map;

      // Allow authenticated users to update canvas (add/remove/modify shapes)
      // This is a collaborative canvas, so any authenticated user can edit
      allow update: if isAuthenticated()
                    && request.resource.data.canvasId == resource.data.canvasId;

      // Allow authenticated users to delete canvas (admin operation)
      // In production, you'd want more restrictive rules here
      allow delete: if isAuthenticated();
    }

    // Sessions collection (for user presence tracking - PR5)
    match /sessions/{canvasId}/{userId} {
      // Users can read all session data (to see who's online)
      allow read: if isAuthenticated();

      // Users can only write their own session data
      allow write: if isOwner(userId);
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
